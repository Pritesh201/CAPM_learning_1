{
  "name": "Students_app",
  "version": "1.0.0",
  "type": "module.cjs",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "@sap/dev-cap-tools": "^1.31.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-customer_order_details": "cds watch --open com.customer.app.customerorderdetails/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "hana"
      },
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": "xsuaa"
      },
      "API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/API_BUSINESS_PARTNER",
        "credentials": {
          "path": "/s4hanacloud/sap/opu/odata/sap/API_BUSINESS_PARTNER",
          "destination": "Business_hub_api"
        }
      },
      "employeeset": {
        "kind": "odata-v2",
        "model": "srv/external/employeeset",
        "credentials": {
          "path": "/sap/opu/odata/sap/ZEMPLOYEE_002_SRV/",
          "destination": "s4_hana_onprem"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/customer_order_details"
  ]
}